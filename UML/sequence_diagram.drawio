<mxfile host="app.diagrams.net" modified="2026-10-10T12:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="lifedrop-sequence" name="Sequence Diagram"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="LifeDrop — Sequence Diagram: Submit Blood Request and Notify Donor" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="15" width="1240" height="40" as="geometry" /></mxCell><mxCell id="p0" value="Patient / Requester" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="85" width="210" height="60" as="geometry" /></mxCell><mxCell id="life0" value="" style="shape=rect;html=1;fillColor=#888888;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="184" y="145" width="2" height="825" as="geometry" /></mxCell><mxCell id="p1" value="LifeDrop Web UI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="85" width="210" height="60" as="geometry" /></mxCell><mxCell id="life1" value="" style="shape=rect;html=1;fillColor=#888888;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="474" y="145" width="2" height="825" as="geometry" /></mxCell><mxCell id="p2" value="Flask Backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="85" width="210" height="60" as="geometry" /></mxCell><mxCell id="life2" value="" style="shape=rect;html=1;fillColor=#888888;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="764" y="145" width="2" height="825" as="geometry" /></mxCell><mxCell id="p3" value="MySQL Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="85" width="210" height="60" as="geometry" /></mxCell><mxCell id="life3" value="" style="shape=rect;html=1;fillColor=#888888;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="1054" y="145" width="2" height="825" as="geometry" /></mxCell><mxCell id="p4" value="Donor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="85" width="210" height="60" as="geometry" /></mxCell><mxCell id="life4" value="" style="shape=rect;html=1;fillColor=#888888;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="1344" y="145" width="2" height="825" as="geometry" /></mxCell><mxCell id="m0" value="1. Enter blood group, location, and units" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="190" as="sourcePoint" /><mxPoint x="475" y="190" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m1" value="2. Submit blood request" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="255" as="sourcePoint" /><mxPoint x="765" y="255" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m2" value="3. Validate request details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="320" as="sourcePoint" /><mxPoint x="850" y="345" as="targetPoint" /><Array as="points"><mxPoint x="850" y="320" /></Array></mxGeometry></mxCell><mxCell id="m3" value="4. Save request and generate request ID" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="385" as="sourcePoint" /><mxPoint x="1055" y="385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m4" value="5. Return request ID and saved status" style="edgeStyle=none;html=1;rounded=0;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="450" as="sourcePoint" /><mxPoint x="765" y="450" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m5" value="6. Search database for matching donors" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="515" as="sourcePoint" /><mxPoint x="1055" y="515" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m6" value="7. Return matching donor details" style="edgeStyle=none;html=1;rounded=0;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="580" as="sourcePoint" /><mxPoint x="765" y="580" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="8. Display confirmation and matching results" style="edgeStyle=none;html=1;rounded=0;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="645" as="sourcePoint" /><mxPoint x="475" y="645" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="9. Send donation request notification" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="710" as="sourcePoint" /><mxPoint x="1345" y="710" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="10. Donor accepts or rejects request" style="edgeStyle=none;html=1;rounded=0;dashed=1;dashPattern=6 6;endArrow=open;endFill=0;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="775" as="sourcePoint" /><mxPoint x="765" y="775" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" value="11. Update request status in database" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="840" as="sourcePoint" /><mxPoint x="1055" y="840" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="12. Show updated request status" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="905" as="sourcePoint" /><mxPoint x="475" y="905" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note" value="Alternate path: If no donors match, the request remains Pending. If a donor rejects, notify the next matching donor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="1000" width="1160" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>